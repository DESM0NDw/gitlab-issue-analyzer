GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=your_gitlab_token_here
GITLAB_PROJECT_ID=your_project_id_here

# Provider: groq | openai | mistral
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Analyse-Einstellungen
MAX_ISSUES=100
CLOSED_ISSUES_DAYS=90
API_RATE_LIMIT=0.5

# Duplikat-Schwellenwerte (0.0 - 1.0)
DUPLICATE_HIGH_THRESHOLD=0.90
DUPLICATE_MEDIUM_THRESHOLD=0.75
